	volume = {36},
	issn = {1323-3580, 1448-6083},
	shorttitle = {{GREENBURST}},
	url = {https://www.cambridge.org/core/journals/publications-of-the-astronomical-society-of-australia/article/greenburst-a-commensal-fast-radio-burst-search-backend-for-the-green-bank-telescope/E232C12BEE049871A5EF8043ED2A2774},
	doi = {10.1017/pasa.2019.26},
	abstract = {We describe the design and deployment of GREENBURST, a commensal Fast Radio Burst (FRB) search system at the Green Bank Telescope. GREENBURST uses the dedicated L-band receiver tap to search over the 960–1 920 MHz frequency range for pulses with dispersion measures out to . Due to its unique design, GREENBURST is capable of conducting searches for FRBs when the L-band receiver is not being used for scheduled observing. This makes it a sensitive single pixel detector capable of reaching deeper in the radio sky. While single pulses from Galactic pulsars and rotating radio transients will be detectable in our observations, and will form part of the database we archive, the primary goal is to detect and study FRBs. Based on recent determinations of the all-sky rate, we predict that the system will detect approximately one FRB for every 2–3 months of continuous operation. The high sensitivity of GREENBURST means that it will also be able to probe the slope of the FRB fluence distribution, which is currently uncertain in this observing band.},
	language = {en},
	urldate = {2025-10-18},
	journal = {Publications of the Astronomical Society of Australia},
	author = {Surnis, Mayuresh P. and Agarwal, D. and Lorimer, D. R. and Pei, X. and Foster, G. and Karastergiou, A. and Golpayegani, G. and Maddalena, R. J. and White, S. and Armour, W. and Cobb, J. and McLaughlin, M. A. and MacMahon, D. H. E. and Siemion, A. P. V. and Werthimer, D. and Williams, C. J.},
	month = jan,
	year = {2019},
	keywords = {instrumentation, miscellaneous – radio continuum, transients},
	pages = {e032},
	file = {Surnis et al. - 2019 - GREENBURST A commensal Fast Radio Burst search back-end for the Green Bank Telescope.pdf:/Users/oj/Library/CloudStorage/GoogleDrive-ojohnson@tcd.ie/My Drive/Academic-Papers/Surnis - 2019 - GREENBURST/Surnis et al. - 2019 - GREENBURST A commensal Fast Radio Burst search back-end for the Green Bank Telescope.pdf:application/pdf},
