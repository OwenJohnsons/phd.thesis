}
@article{sazhin_opportunities_1978,
    title = {Opportunities for detecting ultralong gravitational waves},
    volume = {22},
    issn = {0038-5301},
    url = {https://ui.adsabs.harvard.edu/abs/1978SvA....22...36S},
    abstract = {The effect of superlong gravitational waves on the propagation of electromagnetic pulses is analyzed. The change in period of pulses transmitted with constant period through a gravitational wave field is calculated in a geometrical optics approximation. Conditions under which detection of gravitational waves from binaries is possible by studying the phase modulation of transmitted pulses are derived. It is shown that it might be possible to detect gravitational radiation from binary superstars whose masses are about 10 billion solar masses.},
